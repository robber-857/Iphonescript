{
  "manifest_version": 3,
  "name": "Duo 悉尼库存采集器",
  "version": "1.3.3",
  "description": "为本机 Duo 后台采集 Apple 澳洲门店自提库存。",
  "permissions": [
    "alarms",
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "https://www.apple.com/au/shop/buy-iphone/*",
    "https://*.apple.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "将当前 Apple 商品页指定为采集页"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.apple.com/au/shop/buy-iphone/iphone-duo/*",
        "https://www.apple.com/au/shop/buy-iphone/iphone-18-pro/*"
      ],
      "js": [
        "page-input.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.apple.com/au/shop/buy-iphone/iphone-duo/*",
        "https://www.apple.com/au/shop/buy-iphone/iphone-18-pro/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
